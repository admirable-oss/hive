{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hive.admir-saheta.com/schemas/plugin-submission-v1.json",
  "title": "Hive plugin registry submission",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "plugin_id", "state", "listing", "created_at", "updated_at", "history"],
  "properties": {
    "schema": {"const": 1},
    "plugin_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,62}$"},
    "state": {"enum": ["draft", "submitted", "changes_requested", "approved", "rejected", "withdrawn", "archived"]},
    "listing": {"type": "object", "required": ["id", "name", "repository", "license", "maintainers", "releases"], "properties": {"id": {"type": "string"}, "name": {"type": "string", "minLength": 1}, "repository": {"type": "string", "format": "uri", "pattern": "^https://"}, "license": {"type": "string", "minLength": 1}, "maintainers": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1}, "github_login": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}, "url": {"type": "string", "format": "uri", "pattern": "^https://"}}, "additionalProperties": false}}, "releases": {"type": "array", "minItems": 1}}, "additionalProperties": true},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "transfer": {"type": "object", "required": ["from", "to", "requested_at", "outgoing_approval", "incoming_acceptance"], "properties": {"from": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "to": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}, "requested_at": {"type": "string", "format": "date-time"}, "outgoing_approval": {"type": "string", "minLength": 1}, "incoming_acceptance": {"type": "string", "minLength": 1}}, "additionalProperties": false},
    "history": {"type": "array", "items": {"type": "object", "required": ["at", "actor", "action"], "properties": {"at": {"type": "string", "format": "date-time"}, "actor": {"type": "string", "minLength": 1}, "action": {"enum": ["submitted", "changes_requested", "approved", "rejected", "ownership_transfer_requested", "ownership_transferred", "reported", "appealed", "withdrawn", "archived"]}, "details": {"type": "string"}, "reference": {"type": "string"}}, "additionalProperties": false}}
  }
}
