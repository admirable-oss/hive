<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hive-desktop.exe"
        Arguments=""
        InstallLocation="C:\Program Files\Admirable OSS\Hive">
    </Installer>
    <PackageInformation
        PackageName="Hive"
        PackageDisplayName="Hive"
        PublisherName="CN=Admirable OSS"
        PublisherDisplayName="Admirable OSS"
        Version="0.1.0.0"
        PackageDescription="Coding agents that keep working when you close the window">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="com.admirable-oss.hive.desktop"
                Description="Coding agents that keep working when you close the window"
                DisplayName="Hive"
                ExecutableName="hive-desktop.exe"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hive</DisplayName>
            <PublisherDisplayName>Admirable OSS</PublisherDisplayName>
            <Description>Coding agents that keep working when you close the window</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="Hive.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
