[Desktop Entry]
Version=1.0
Name=Hive
Comment=Coding agents that keep working when you close the window
# The Exec line includes %u to pass the URL to the application
Exec=/usr/local/bin/hive-desktop %u
Terminal=false
Type=Application
Icon=hive-desktop
Categories=Utility;
StartupWMClass=hive-desktop

MimeType=x-scheme-handler/hive; 
